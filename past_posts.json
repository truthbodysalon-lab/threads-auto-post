    "views": 8,
    "replies_count": 0
  },
  {
    "id": "18172301524465909",
    "text": "薬に頼らず頭痛を減らしたい方へ。",
    "timestamp": "2026-11-20T22:49:19+0000",
    "like_count": 0,
